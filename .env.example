# Bu dosyayı ".env" adıyla kopyalayın ve doldurun. .env dosyasını kimseyle paylaşmayın.
# Cloudflare API token: Zone > Analytics > Read (isteğe bağlı: WAF okuma, kural durumları için)
CF_API_TOKEN=
# Picus refresh token (Picus > Settings > Rest API Token) - isteğe bağlı
PICUS_API_TOKEN=
# PICUS_API_URL=https://api.picussecurity.com
# Zone / test host / Picus IP'leri Ayarlar sayfasından da girilebilir:
# CF_ZONE_ID=
# TARGET_HOST=
# PICUS_IPS=
# Dinleme adresi: 127.0.0.1 = sadece sunucunun içinden erişim (önerilen). Dışarı açmak için 0.0.0.0
HOST=127.0.0.1
PORT=9999
# Kurumsal proxy gerekiyorsa:
# HTTPS_PROXY=http://proxy.ornek.local:8080
